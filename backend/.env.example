# ─── Aura Music API ───────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Set to 1 when running behind Render / Vercel / Nginx so rate limits see real client IPs.
TRUST_PROXY=0

# Required in production. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Storage: leave MONGODB_URI empty for an in-memory store (dev only).
# MongoDB Atlas free tier works: mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=
MONGODB_DB=aura

# Music sources, in priority order: audius (full tracks), deezer (30s previews), jamendo (full, needs key)
CATALOG_PROVIDERS=audius,deezer
AUDIUS_APP_NAME=aura-music-player
# Optional: get one at https://audius.co/settings → Developer apps. Kept server-side only.
AUDIUS_API_KEY=
# Optional: https://devportal.jamendo.com  (then add "jamendo" to CATALOG_PROVIDERS)
JAMENDO_CLIENT_ID=

# Browser origins allowed by CORS (the mobile app doesn't need this). Comma separated.
CORS_ORIGINS=

ALLOW_REGISTRATION=true
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AUTH_PER_15MIN=20
RATE_LIMIT_SEARCH_PER_MIN=90
